
@{
    ViewBag.Title = "Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var booking = ViewBag.Booking as Airlinemgmtsystem.Booking;
    var flight = ViewBag.Flight as Airlinemgmtsystem.Flight;
}
<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h3>Complete Your Payment</h3>
    </div>

    <div class="card-body">

        <div class="row">

            <!-- Booking Summary -->

            <div class="col-md-5">

                <div class="card border-primary">

                    <div class="card-header bg-light">
                        <h5>Booking Summary</h5>
                    </div>

                    <div class="card-body">

                        <table class="table">

                            <tr>
                                <th>Booking ID</th>
                                <td>@booking.BookingID</td>
                            </tr>

                            <tr>
                                <th>Flight</th>
                                <td>@flight.FlightNumber</td>
                            </tr>

                            <tr>
                                <th>Airline</th>
                                <td>@flight.Airline</td>
                            </tr>

                            <tr>
                                <th>Route</th>
                                <td>@flight.Source → @flight.Destination</td>
                            </tr>

                            <tr>
                                <th>Travel Date</th>
                                <td>@flight.DepartureTime.ToString("dd MMM yyyy")</td>
                            </tr>

                            <tr>
                                <th>Total Amount</th>
                                <td class="text-success">
                                    <h4>₹@booking.TotalAmount</h4>
                                </td>
                            </tr>

                        </table>

                    </div>

                </div>

            </div>

            <!-- Payment -->

            <div class="col-md-7">

                @using (Html.BeginForm())
                {
                    @Html.Hidden("bookingId", booking.BookingID)

                                   <label class="fw-bold">
                                    Select Payment Method
                                </label>

                                <div class="form-check">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="Credit Card"
                                           checked
                                           class="paymentOption form-check-input">

                                    <label class="form-check-label">
                                        Credit Card
                                    </label>

                                </div>

                                <div class="form-check">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="Debit Card"
                                           class="paymentOption form-check-input">

                                    <label class="form-check-label">
                                        Debit Card
                                    </label>

                                </div>

                                <div class="form-check">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="UPI"
                                           class="paymentOption form-check-input">

                                    <label class="form-check-label">
                                        UPI
                                    </label>

                                </div>

                                <div class="form-check">

                                    <input type="radio"
                                           name="paymentMethod"
                                           value="Net Banking"
                                           class="paymentOption form-check-input">

                                    <label class="form-check-label">
                                        Net Banking
                                    </label>

                                </div>

                                         <div id="cardDiv">

                                        <input class="form-control mb-3"
                                               name="CardHolder"
                                               placeholder="Card Holder Name" />

                                        <input class="form-control mb-3"
                                               name="CardNumber"
                                               placeholder="Card Number" />

                                        <div class="row">

                                            <div class="col-md-6">

                                                <input class="form-control"
                                                       placeholder="MM/YY" />

                                            </div>

                                            <div class="col-md-6">

                                                <input class="form-control"
                                                       placeholder="CVV" />

                                            </div>

                                        </div>

                                    </div>
                                    <div id="upiDiv" style="display:none">

                                        <input class="form-control"

                                               name="UpiId"

                                               placeholder="example@upi" />

                                    </div>
                                    <div id="netBankingDiv" style="display:none">

                                        <select class="form-control mb-3"
                                                name="Bank">

                                            <option>SBI</option>
                                            <option>HDFC</option>
                                            <option>ICICI</option>
                                            <option>Axis</option>

                                        </select>

                                        <input class="form-control mb-3"
                                               name="NetUserId"
                                               placeholder="User ID" />

                                        <input class="form-control"
                                               type="password"
                                               name="NetPassword"
                                               placeholder="Password" />

                                    </div>
                                    <div class="alert alert-success mt-4">

                                    <h4>

                                    Amount Payable :

                                    ₹@booking.TotalAmount

                                    </h4>

                                    </div>
                                    <button class="btn btn-success btn-lg w-100">

                                    Pay ₹@booking.TotalAmount

                                    </button>

                }

            </div>

        </div>

    </div>

</div>

<script>

    $(function () {

        $(".paymentOption").change(function () {

            var type = $("input[name='paymentMethod']:checked").val();

            $("#cardDiv").hide();

            $("#upiDiv").hide();

            $("#netBankingDiv").hide();

            if (type == "Credit Card" || type == "Debit Card") {
                $("#cardDiv").show();
            }

            else if (type == "UPI") {
                $("#upiDiv").show();
            }

            else {
                $("#netBankingDiv").show();
            }

        });

    });

</script>
