</div>
<div class="row">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-info text-white">

                Today's Bookings

            </div>

            <div class="card-body">

                <h2 class="text-center">

                    @ViewBag.TodayBookings

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-success text-white">

                Today's Revenue

            </div>

            <div class="card-body">

