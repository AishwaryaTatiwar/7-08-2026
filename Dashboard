public ActionResult Dashboard()
{
    ViewBag.TotalFlights = db.Flights.Count();

    ViewBag.TotalUsers = db.Users.Count(x => x.Role == "User");

    ViewBag.TotalBookings = db.Bookings.Count();

    ViewBag.TotalRevenue = db.Payments
                             .Where(x => x.PaymentStatus == "Success")
                             .Sum(x => (decimal?)x.Amount) ?? 0;

    ViewBag.ConfirmedBookings = db.Bookings
                                  .Count(x => x.BookingStatus == "Confirmed");

    ViewBag.PendingBookings = db.Bookings
                                .Count(x => x.BookingStatus == "Pending");

    ViewBag.CancelledBookings = db.Bookings
                                  .Count(x => x.BookingStatus == "Cancelled");

    ViewBag.AvailableSeats = db.Flights.Sum(x => (int?)x.AvailableSeats) ?? 0;

    ViewBag.TodayBookings = db.Bookings
                              .Count(x => x.BookingDate.Date == DateTime.Today);

    ViewBag.TodayRevenue = db.Payments
                             .Where(x => x.PaymentDate.Value.Date == DateTime.Today &&
                                         x.PaymentStatus == "Success")
                             .Sum(x => (decimal?)x.Amount) ?? 0;

    return View();
}
@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">

    <h2 class="mb-4">
        Airline Management Dashboard
