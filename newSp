CREATE PROCEDURE sp_SearchFlights
    @Source NVARCHAR(50),
    @Destination NVARCHAR(50),
    @TravelDate DATE
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        FlightID,
        FlightNumber,
        Airline,
        Source,
        Destination,
        DepartureTime,
        ArrivalTime,
        Price,
        TotalSeats,
        AvailableSeats,
        Status
    FROM Flights
    WHERE Source = @Source
      AND Destination = @Destination
      AND CAST(DepartureTime AS DATE) = @TravelDate
      AND Status = 'Scheduled'
      AND AvailableSeats > 0
    ORDER BY DepartureTime;
END;

CREATE PROCEDURE sp_AdminSearchFlights
    @SearchText NVARCHAR(100)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT *
    FROM Flights
    WHERE FlightNumber LIKE '%' + @SearchText + '%'
       OR Airline LIKE '%' + @SearchText + '%'
    ORDER BY DepartureTime DESC;
END;

CREATE PROCEDURE sp_AdminSearchUsers
    @Name NVARCHAR(100)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        UserID,
        Username,
        Email,
        Role
    FROM Users
    WHERE Username LIKE '%' + @Name + '%'
    ORDER BY Username;
END;

CREATE PROCEDURE sp_AdminSearchBooking
    @BookingID INT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        B.BookingID,
        U.Username,
        F.FlightNumber,
        B.BookingDate,
        B.TotalAmount,
        B.BookingStatus
    FROM Bookings B
    INNER JOIN Users U
        ON B.UserID = U.UserID
    INNER JOIN Flights F
        ON B.FlightID = F.FlightID
    WHERE B.BookingID = @BookingID;
END;

CREATE PROCEDURE sp_GetFlightSeats
    @FlightID INT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        SeatID,
        SeatNumber,
        SeatType,
        IsBooked,
        PassengerID
    FROM FlightSeats
    WHERE FlightID = @FlightID
    ORDER BY SeatNumber;
END;

