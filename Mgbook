public ActionResult ManageBookings()
{
    var bookings = db.Bookings
                     .OrderByDescending(x => x.BookingDate)
                     .ToList();

    return View(bookings);
}
@model IEnumerable<Airlinemgmtsystem.Booking>

@{
    ViewBag.Title = "Manage Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card shadow">

<div class="card-header bg-primary text-white">

<h3>

Manage Bookings

</h3>

</div>

<div class="card-body">

<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>

            <th>Booking ID</th>

            <th>User ID</th>

            <th>Flight ID</th>

            <th>Date</th>

            <th>Amount</th>

            <th>Status</th>

            <th width="180">Action</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.BookingID</td>

                <td>@item.UserID</td>

                <td>@item.FlightID</td>

                <td>@item.BookingDate.ToString("dd MMM yyyy")</td>

                <td>₹@item.TotalAmount</td>

                <td>

                    @if (item.BookingStatus == "Confirmed")
                    {
                        <span class="badge bg-success">
                            Confirmed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning">
                            Pending
                        </span>
                    }

                </td>

                <td>

                    <a href="@Url.Action("BookingSummary","Booking",
                        new { bookingId = item.BookingID })"
                       class="btn btn-info btn-sm">

                        View

                    </a>

                    <a href="@Url.Action("DeleteBooking","Admin",
                        new { id = item.BookingID })"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this booking?')">

                        Delete

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
</div>

</div>
