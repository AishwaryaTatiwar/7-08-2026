<div class="mb-3">
    <label>Security Question</label>
    <input type="text"
           class="form-control"
           value="What is your favourite colour?"
           readonly />
</div>

<div class="mb-3">
    <label>Security Answer</label>
    @Html.TextBoxFor(m => m.SecurityAnswer,
        new
        {
            @class = "form-control",
            placeholder = "Enter your answer"
        })
</div>

if (string.IsNullOrWhiteSpace(model.SecurityAnswer))
{
    ViewBag.Message = "Security Answer is required.";
    return View(model);
}
if (model.PasswordHash != ConfirmPassword)
{
    ViewBag.Message = "Passwords do not match.";
    return View(model);
}

if (string.IsNullOrWhiteSpace(model.SecurityAnswer))
{
    ViewBag.Message = "Security Answer is required.";
    return View(model);
}

if (model.Role == "Admin" && adminExists)
{
    ViewBag.Message = "Only one Admin is allowed.";
    return View(model);
}

model.PasswordHash = Crypto.HashPassword(model.PasswordHash);
model.CreatedAt = DateTime.Now;

db.Users.Add(model);
db.SaveChanges();

TempData["Success"] = "Registration Successful.";
return RedirectToAction("Login");

