@using (Html.BeginForm())
{
    <div class="row">
        <div class="col-md-4">
            <label class="form-label">Source</label>
            <input type="text" name="source" class="form-control" required />
        </div>

        <div class="col-md-4">
            <label class="form-label">Destination</label>
            <input type="text" name="destination" class="form-control" required />
        </div>

        <div class="col-md-3">
            <label class="form-label">Travel Date</label>
            <input type="date" name="travelDate" class="form-control" required />
        </div>

        <div class="col-md-1 d-grid">
            <label>&nbsp;</label>
            <button class="btn btn-primary">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>
}
[HttpPost]
public ActionResult SearchFlights(string source, string destination, DateTime travelDate)
{
    var flights = db.Flights
                    .Where(f => f.Source == source
                             && f.Destination == destination
                             && f.DepartureTime.Year == travelDate.Year
                             && f.DepartureTime.Month == travelDate.Month
                             && f.DepartureTime.Day == travelDate.Day
                             && f.Status == "Scheduled"
                             && f.AvailableSeats > 0)
                    .ToList();

    return View(flights);
}
