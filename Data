int seatCount = 0;
char row = 'A';

while (seatCount < model.TotalSeats)
{
    for (int i = 1; i <= 6 && seatCount < model.TotalSeats; i++)
    {
        FlightSeat fs = new FlightSeat();

        fs.FlightID = model.FlightID;
        fs.SeatNumber = row.ToString() + i;

        // Window, Middle, Aisle
        if (i == 1 || i == 6)
            fs.SeatType = "Window";
        else if (i == 2 || i == 5)
            fs.SeatType = "Middle";
        else
            fs.SeatType = "Aisle";

        fs.IsBooked = false;
        fs.PassengerID = null;

        db.FlightSeats.Add(fs);

        seatCount++;
    }

    row++;
}

db.SaveChanges();
