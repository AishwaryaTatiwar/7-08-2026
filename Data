model.AvailableSeats = model.TotalSeats;

db.Flights.Add(model);
db.SaveChanges();

// Populate FlightSeats table
int seatCount = 0;
char row = 'A';

while (seatCount < model.TotalSeats)
{
    for (int col = 1; col <= 6 && seatCount < model.TotalSeats; col++)
    {
        FlightSeat seat = new FlightSeat();

        seat.FlightID = model.FlightID;
        seat.SeatNumber = row.ToString() + col;
        seat.SeatType = "Economy";
        seat.IsBooked = false;
        seat.PassengerID = null;

        db.FlightSeats.Add(seat);

        seatCount++;
    }

    row++;
}

db.SaveChanges();

TempData["Success"] = "Flight added successfully";
return RedirectToAction("ManageFlights", "Admin");
