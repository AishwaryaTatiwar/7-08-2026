ALTER TABLE Users
ADD SecurityAnswer NVARCHAR(255) NOT NULL DEFAULT('');

RegisterController
model.SecurityAnswer=Crypto.HashPassword(model.SecurityAnswer.Trim().ToLower());

ForgotPasswordController
bool isValid=Crypto.VerifyHashedPassword(
    user.SecurityAnswer,
    SecurityAnswer.Trim().ToLower());

if(!isValid)
{
    ViewBag.Message="Invalid Security Answer.";
    return View();
}

