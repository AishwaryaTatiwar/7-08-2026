CREATE TABLE Payments
(
    PaymentID INT IDENTITY(1,1) PRIMARY KEY,

    BookingID INT NOT NULL,

    PaymentMethod NVARCHAR(30) NOT NULL,

    TransactionID NVARCHAR(100) NOT NULL,

    Amount DECIMAL(10,2) NOT NULL,

    PaymentStatus NVARCHAR(20) NOT NULL,

    PaymentDate DATETIME NOT NULL DEFAULT(GETDATE()),

    CONSTRAINT FK_Payments_Bookings
    FOREIGN KEY (BookingID)
    REFERENCES Bookings(BookingID)
);
[HttpPost]
public ActionResult Payment(int bookingId,
                            string paymentMethod)
{
    Booking booking = db.Bookings.Find(bookingId);

    Payment payment = new Payment();

    payment.BookingID = booking.BookingID;

    payment.PaymentMethod = paymentMethod;

    payment.Amount = booking.TotalAmount;

    payment.PaymentStatus = "Success";

    payment.PaymentDate = DateTime.Now;

    payment.TransactionID = "TXN"
                          + DateTime.Now.ToString("yyyyMMddHHmmss")
                          + new Random().Next(1000,9999);

    db.Payments.Add(payment);

    booking.BookingStatus = "Confirmed";

    db.SaveChanges();

    return RedirectToAction("BookingSummary",
                            new
                            {
                                bookingId=booking.BookingID
                            });
}
<div class="mb-3">

    <label class="fw-bold">
        Select Payment Method
    </label>

    <div class="form-check">

        <input type="radio"
               name="paymentMethod"
               value="Credit Card"
               checked
               class="paymentOption form-check-input">

        <label class="form-check-label">
            Credit Card
        </label>

    </div>

    <div class="form-check">

        <input type="radio"
               name="paymentMethod"
               value="Debit Card"
               class="paymentOption form-check-input">

        <label class="form-check-label">
            Debit Card
        </label>

    </div>

    <div class="form-check">

        <input type="radio"
               name="paymentMethod"
               value="UPI"
               class="paymentOption form-check-input">

        <label class="form-check-label">
            UPI
        </label>

    </div>

    <div class="form-check">

        <input type="radio"
               name="paymentMethod"
               value="Net Banking"
               class="paymentOption form-check-input">

        <label class="form-check-label">
            Net Banking
        </label>

    </div>

</div>

<div id="cardDiv">

    <input class="form-control mb-3"
           name="CardHolder"
           placeholder="Card Holder Name" />

    <input class="form-control mb-3"
           name="CardNumber"
           placeholder="Card Number" />

    <div class="row">

        <div class="col-md-6">

            <input class="form-control"
                   placeholder="MM/YY" />

        </div>

        <div class="col-md-6">

            <input class="form-control"
                   placeholder="CVV" />

        </div>

    </div>

</div>
<div id="upiDiv" style="display:none">

    <input class="form-control"

           name="UpiId"

           placeholder="example@upi" />

</div>
<div id="netBankingDiv" style="display:none">

    <select class="form-control mb-3"
            name="Bank">

        <option>SBI</option>
        <option>HDFC</option>
        <option>ICICI</option>
        <option>Axis</option>

    </select>

    <input class="form-control mb-3"
           name="NetUserId"
           placeholder="User ID" />

    <input class="form-control"
           type="password"
           name="NetPassword"
           placeholder="Password" />

</div>
<div class="alert alert-success mt-4">

<h4>

Amount Payable :

₹@booking.TotalAmount

</h4>

</div>
<button class="btn btn-success btn-lg w-100">

Pay ₹@booking.TotalAmount

</button>
<script>

$(function(){

$(".paymentOption").change(function(){

var type=$("input[name='paymentMethod']:checked").val();

$("#cardDiv").hide();

$("#upiDiv").hide();

$("#netBankingDiv").hide();

if(type=="Credit Card" || type=="Debit Card")
{
$("#cardDiv").show();
}

else if(type=="UPI")
{
$("#upiDiv").show();
}

else
{
$("#netBankingDiv").show();
}

});

});

</script>
