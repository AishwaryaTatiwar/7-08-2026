@{
    ViewBag.Title = "Seat Selection";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var passengers = ViewBag.Passengers as List<Airlinemgmtsystem.Passenger>;
    var seats = ViewBag.Seats as List<Airlinemgmtsystem.FlightSeat>;
}

<div class="alert alert-info">

    <div class="row">

        <div class="col-md-4">
            <strong>Flight Fare</strong><br />
            ₹<span id="BaseFare">@ViewBag.BaseFare</span>
        </div>

        @*<div class="col-md-4">
            <strong>Seat Charges</strong><br />
            ₹<span id="SeatCharges">0</span>
        </div>*@

        <div class="col-md-4">
            <strong>Total Amount</strong><br />
            <span id="TotalAmount">@ViewBag.BaseFare</span>
        </div>

    </div>

</div>
<div class="card shadow mb-3">
    <div class="card-header bg-primary text-white">
        <h3>Select Seats</h3>
    </div>

    <div class="card-body">

        <label>Select Passenger</label>

        <select id="Passenger" class="form-control mb-4">

            @foreach (var p in passengers)
            {
                <option value="@p.PassengerID">
                    @p.PassengerName
                </option>
            }

        </select>
        <div class="row">

            @foreach (var seat in seats)
            {
                string color = seat.IsBooked ? "btn-danger" : "btn-success";

                <div class="col-2 mb-2">

                    @{
                int seatPrice = 0;

                if (seat.SeatType == "Window")
                {
                    seatPrice = 800;
                }
                else if (seat.SeatType == "Aisle")
                {
                    seatPrice = 500;
                }
                else
                {
                    seatPrice = 300;
                }
                 }

                    <button type="button"
                            class="btn @color seatBtn w-100"
                            data-seatid="@seat.SeatID"
                            data-seat="@seat.SeatNumber"
                            data-price="@seatPrice"
                            title="@seat.SeatType Seat (+₹@seatPrice)"
                            @(seat.IsBooked ? "disabled" : "")>

                        @seat.SeatNumber
                    </button>

                                    </div>
                                }

                            </div>
                            @using (Html.BeginForm("SeatSelection", "Booking", FormMethod.Post))
                            {
                                <input type="hidden" id="BookingID"
                                       name="bookingId"
                                       value="@ViewBag.BookingID" />

                                <div id="SeatContainer"></div>

                                <button class="btn btn-primary mt-4">
                                    Continue to Payment
                                </button>
                                <input type="hidden" id="FinalAmount" name="FinalAmount" />
                            }
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

        <script>

            var allocations=[];

            $(".seatBtn").click(function(){

                var passenger=$("#Passenger").val();

                var passengerName=$("#Passenger option:selected").text();

                var seatId=$(this).data("seatid");

                var seatNo=$(this).data("seat");
                var seatPrice=$(this).data("price");

                allocations=allocations.filter(x => x.passenger!=passenger);

                allocations.push({
                    passenger: passenger,
                    seat: seatId,
                    price: seatPrice
                });

                $(this).removeClass("btn-success");

                $(this).addClass("btn-primary");

                renderHidden();

                updateAmount();

            });

            function renderHidden(){

                var html="";

                allocations.forEach(function(x){

                    html+="<input type='hidden' name='passengerId' value='"+x.passenger+"'/>";

                    html+="<input type='hidden' name='seatId' value='"+x.seat+"'/>";

                });

                $("#SeatContainer").html(html);

            }

            function updateAmount() {

                var baseFare = parseInt($("#BaseFare").text());

                var seatCharge = 0;

                allocations.forEach(function(x) {
                    seatCharge += parseInt(x.price);
                });

                $("#SeatCharge").text(seatCharge);

                $("#TotalAmount").text(baseFare + seatCharge);
                $("#FinalAmount").val(baseFare + seatCharge);
            }

        

        </script>
